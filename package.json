{
  "name": "mimi-game",
  "private": true,
  "version": "0.2.0",
  "description": "MIMI: mascota de gelatina lavanda con progresión, misiones, pausa activa y minijuego MIMI HOP (Phaser + TypeScript + Vite).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
